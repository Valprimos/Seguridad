# Copia este archivo como .env y ajusta los valores para producción.
# En Render/Railway NO subas este archivo: pon estas mismas claves
# en el panel de "Environment Variables" de tu servicio.

# Puerto en el que escucha la API (la mayoría de hostings, ej. Render,
# lo inyectan automáticamente; no suele hacer falta tocarlo).
PORT=4000

# Dominio(s) del frontend que pueden llamar a esta API, separados por
# coma. Si lo dejas vacío, se permite cualquier origen.
CORS_ORIGIN=https://tu-frontend.vercel.app

# --- Datos reales de cuotas (The Odds API) ---------------------------
# Si defines ODDS_API_KEY, la app deja de usar datos DEMO y usa cuotas
# reales de https://the-odds-api.com. Si la dejas vacía o la borras,
# vuelve automáticamente a modo DEMO.
ODDS_API_KEY=

# Cada cuántos minutos se consulta de verdad a The Odds API (el resto
# de peticiones del frontend se sirven desde caché, para no gastar
# créditos). 20-30 min es un buen punto de partida con el plan gratuito.
ODDS_API_REFRESH_MINUTES=20

# Región de casas de apuestas a consultar (eu = casas europeas, que es
# donde están Bet365, Betfair, Unibet, etc. en su versión europea).
ODDS_API_REGIONS=eu

# Qué ligas/deportes consultar, separados por coma (claves de The Odds
# API). Menos claves = menos créditos gastados por refresco. Puedes ver
# la lista completa disponible en la documentación de The Odds API.
ODDS_API_SPORTS=soccer_epl,soccer_spain_la_liga,soccer_uefa_champs_league,basketball_nba,icehockey_nhl
